# GridMind AI Backend Environment Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (comma-separated)
# In production, replace or append Firebase Hosting domain (e.g. https://your-app.web.app)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Phase 5 Google Gemini AI Configuration
# Set your Google Gemini API key (keep private, do not commit real keys!)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_REQUEST_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2
INVESTIGATION_MAX_FINDINGS_PER_REPORT=5

